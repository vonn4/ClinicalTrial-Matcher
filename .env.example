# ClinicalTrial Matcher — OpenAI model-assisted workflow (local-only)
# Copy this to .env or run: python configure_openai.py --enable
# IMPORTANT: ChatGPT subscription does NOT include API usage.
# API calls can incur charges; never rely on a project budget as a guaranteed spending cutoff.
# DO NOT COMMIT .env; never include real patient data.
ENABLE_LIVE_AI=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PROFILE_MODEL=gpt-4.1-mini
# Must be explicitly true to permit potentially billable inference.
OPENAI_ALLOW_BILLABLE=false
# The browser uses this token ONLY; never expose OPENAI_API_KEY to the frontend.
LIVE_AI_ACCESS_TOKEN=
MAX_LIVE_AI_REQUESTS_PER_HOUR=12
MAX_AGENT_MODEL_CALLS_PER_HOUR=24
MAX_ASSESSMENTS=3
ENABLE_SEMANTIC=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
