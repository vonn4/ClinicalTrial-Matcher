# Keep a free-only Google AI Studio project and do not enable billing.
# DO NOT commit a real key. Use synthetic descriptions ONLY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROFILE_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Explicit opt-in ONLY on trusted local backend, never on public open endpoints.
ENABLE_LIVE_AI=false
ENABLE_SEMANTIC=false
MAX_ASSESSMENTS=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For local development; do not place tokens in git or a public website.
LIVE_AI_ACCESS_TOKEN=
# Hard fail after this many authorized live AI workflow requests/hour (process-local only)
MAX_LIVE_AI_REQUESTS_PER_HOUR=12
